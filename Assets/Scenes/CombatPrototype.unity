    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\uCE74\uB4DC\uB97C \uD074\uB9AD\uD558\uBA74 \uD31D\uC5C5\uC774 \uB739\uB2C8\uB2E4.\n\uC81C\uD55C\uC2DC\uAC04
    \uC548\uC5D0 \uAC00\uC774\uB4DC\uB97C \uB530\uB77C 80% \uC774\uC0C1 \uBE44\uC2B7\uD558\uAC8C
    \uADF8\uB9AC\uBA74 \uCE74\uB4DC\uAC00 \uBC1C\uB3D9\uB429\uB2C8\uB2E4.\n\uC2E4\uD328\uD558\uBA74
    \uCE74\uB4DC\uB9CC \uC18C\uBAA8\uB418\uACE0 \uD6A8\uACFC\uB294 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uC801\uC744
    \uBAA8\uB450 \uCC98\uCE58\uD558\uBA74 \uC2B9\uB9AC, 10\uC2A4\uD14C\uC774\uC9C0\uB97C
    \uBAA8\uB450 \uD074\uB9AC\uC5B4\uD558\uBA74 \uAC8C\uC784 \uD074\uB9AC\uC5B4\uC785\uB2C8\uB2E4."
